#include "resource.h"
#include "windows.h"


/////////////////////////////////////////////////////////////////////////////

/////////////////////////////////////////////////////////////////////////////
// 中文(简体，中国) resources

#if !defined(AFX_RESOURCE_DLL) || defined(AFX_TARG_CHS)
#ifdef _WIN32
LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_SIMPLIFIED
#endif //_WIN32

/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_MAIN_DIALOG DIALOGEX 0, 0, 320, 180
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Explorer 上下文菜单管理器"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    CONTROL         "启用 BreakFolder 菜单",IDC_BREAKFOLDER_CHECK,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,20,30,200,15
    CONTROL         "启用 NewFolder 菜单",IDC_NEWFOLDER_CHECK,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,20,50,200,15
    DEFPUSHBUTTON   "应用",IDC_APPLY_BUTTON,20,100,80,25
    PUSHBUTTON      "关于",IDC_ABOUT_BUTTON,120,100,80,25
    PUSHBUTTON      "退出",IDC_EXIT_BUTTON,220,100,80,25
    LTEXT           "管理 Windows Explorer 上下文菜单扩展",IDC_STATIC,20,10,280,15
END

IDD_ABOUT_DIALOG DIALOGEX 0, 0, 260, 180
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "关于 ExplorerEnhancementManager"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    ICON            IDI_APPLICATION,IDC_STATIC,10,10,20,20
    LTEXT           "Explorer 扩展上下文菜单管理器 v1.0",IDC_STATIC,40,10,210,15
    LTEXT           "用于管理 Windows Explorer 上下文菜单扩展",IDC_STATIC,20,40,220,15
    LTEXT           "支持网站: https://github.com/anpho/WindowsExplorerExtension",IDC_STATIC,20,70,220,60
    DEFPUSHBUTTON   "确定",IDOK,100,140,60,25,WS_GROUP
END

#endif    // 中文(简体，中国) resources
/////////////////////////////////////////////////////////////////////////////
